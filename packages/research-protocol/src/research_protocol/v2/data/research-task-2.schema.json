{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-task/2",
  "title": "ResearchTaskV2",
  "description": "Envelope CAIN -> domain. Structural rules only; research_protocol.v2.validate_task also checks the payload against the domain request_schema (domains.json), the ID prefixes (episode_id, previous_task_id, based_on, IDs) against 'domain', payload_sha256, task_id derivation and client_ref. See SPEC_V2.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "domain",
    "task_id",
    "episode_id",
    "previous_task_id",
    "proposal_id",
    "based_on",
    "request_id",
    "research_id",
    "hypothesis_id",
    "created_at",
    "producer",
    "payload_schema",
    "payload",
    "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "research-task/2"},
    "domain": {"enum": ["brasileirao", "crypto", "stocks"]},
    "task_id": {"type": "string", "pattern": "^(brasileirao|crypto|stocks):TASK-[0-9a-f]{32}$"},
    "episode_id": {"$ref": "#/$defs/episode_id"},
    "previous_task_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^(brasileirao|crypto|stocks):TASK-[0-9a-f]{32}$"}
      ]
    },
    "proposal_id": {"type": "string", "pattern": "^cain:[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "based_on": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/qualified_id"}
    },
    "request_id": {"$ref": "#/$defs/qualified_id"},
    "research_id": {"$ref": "#/$defs/qualified_id"},
    "hypothesis_id": {"$ref": "#/$defs/qualified_id"},
    "created_at": {"$ref": "#/$defs/utc"},
    "producer": {"enum": ["cain"]},
    "payload_schema": {
      "enum": ["brasileirao-research-request/1", "crypto-research-request/1", "stocks-research-request/1"]
    },
    "payload": {
      "type": "object",
      "required": ["client_ref", "request_id", "research_id", "hypothesis_id"],
      "properties": {
        "client_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "task_id"],
          "properties": {
            "schema": {"const": "research-client-ref/2"},
            "task_id": {"type": "string", "pattern": "^(brasileirao|crypto|stocks):TASK-[0-9a-f]{32}$"}
          }
        }
      }
    },
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "qualified_id": {
      "type": "string",
      "pattern": "^(brasileirao|crypto|stocks):[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^(brasileirao|crypto|stocks):episode-[1-9][0-9]{0,11}$"
    },
    "utc":{"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
