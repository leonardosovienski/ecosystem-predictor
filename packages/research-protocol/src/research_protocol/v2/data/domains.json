                          "SHUFFLED_LABELS",
                          "TEMPORAL_ABLATION",
                          "FEATURE_ABLATION",
                          "UNIVERSE_PERTURBATION"
                        ]
                      },
                      "seed": {
                        "maximum": 1000000,
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
