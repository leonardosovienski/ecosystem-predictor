            "type": "object"
          },
          "hypothesis_id": {
            "$ref": "#/$defs/br_id"
          },
          "priority_hint": {
            "enum": [
              "LOW",
              "NORMAL",
              "HIGH"
            ]
          },
          "references": {
            "additionalProperties": false,
            "properties": {
              "baseline": {
                "$ref": "#/$defs/ref"
              },
              "cost_model": {
                "$ref": "#/$defs/ref"
              },
              "dataset": {
                "$ref": "#/$defs/ref"
              },
              "features": {
                "$ref": "#/$defs/ref"
              },
              "model": {
                "$ref": "#/$defs/ref"
              },
              "odds": {
                "$ref": "#/$defs/ref"
              }
            },
            "required": [
              "dataset",
              "model",
              "features",
              "baseline",
              "cost_model"
            ],
            "type": "object"
          },
          "request_id": {
            "$ref": "#/$defs/br_id"
          },
          "request_type": {
            "enum": [
              "WALKFORWARD_FORECAST_EVALUATION"
            ]
          },
          "research_id": {
            "$ref": "#/$defs/br_id"
          },
          "schema_version": {
            "const": "brasileirao-research-request/1"
          },
          "season": {
            "maximum": 2100,
            "minimum": 2000,
            "type": "integer"
          },
          "target": {
            "enum": [
              "1X2",
              "OU25"
            ]
          }
