          "events": {
            "additionalProperties": false,
            "description": "kickoff_from < kickoff_to; fixtures (opcional) = event_ids com o kickoff esperado, conferido contra o dataset (divergência = KICKOFF_MISMATCH)",
            "properties": {
              "fixtures": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "event_id": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "kickoff_at": {
                      "$ref": "#/$defs/utc"
                    }
                  },
                  "required": [
                    "event_id",
                    "kickoff_at"
                  ],
                  "type": "object"
                },
                "maxItems": 400,
                "minItems": 1,
                "type": "array"
              },
              "kickoff_from": {
                "$ref": "#/$defs/utc"
              },
              "kickoff_to": {
                "$ref": "#/$defs/utc"
