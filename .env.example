# Copy to .env for local development. Every value here is a placeholder -
# there is no working default for any secret or endpoint; the process
# refuses to start with these values unless you provide real ones.
ECOSYSTEM_ENVIRONMENT=development
ECOSYSTEM_JWT_SECRET=change-me-dev-only-not-a-real-secret
ECOSYSTEM_JWT_AUDIENCE=ecosystem-predictor
ECOSYSTEM_CORS_ALLOW_ORIGINS=http://localhost:3000
ECOSYSTEM_DATABASE_URL=postgresql+asyncpg://ecosystem:ecosystem@localhost:5432/ecosystem
ECOSYSTEM_REDIS_URL=redis://localhost:6379/0
ECOSYSTEM_OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
ECOSYSTEM_OBJECT_STORAGE_BUCKET=ecosystem-predictor-dev
ECOSYSTEM_OBJECT_STORAGE_ACCESS_KEY=minioadmin
ECOSYSTEM_OBJECT_STORAGE_SECRET_KEY=minioadmin
ECOSYSTEM_OTEL_SERVICE_NAME=ecosystem-predictor
ECOSYSTEM_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
ECOSYSTEM_PLUGIN_GROUP=predictor.plugins
# Domains that must load and report healthy before the gateway is ready.
# Cripto remains research-only/source-gated; F1 and Brasileirao are CLI-only.
ECOSYSTEM_REQUIRED_DOMAINS=lol,cs
